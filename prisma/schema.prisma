// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum NotificationType {
  PUBLISHED_POST
  COMMENT_POST
  LIKE_POST
  RECEIVED_MESSAGE
  BOOKMARKED_POST
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  COURSE_ENROLLEMENT
  COURSE_PUBLISHED
  SYSTEM
}

enum AdminType {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
}

enum FileTypes {
  IMAGE
  VIDEO
  PDF
  EXCEL
  WORD
  PPT
  TXT
  OTHER
}

enum UserRoles {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING
  CONFIRMED
  BANED
}

enum AcademicSystem {
  ENG
  LMD
  CLASSIC
}

enum DegreeCycle {
  LICENSE
  MASTER
  DOCTORATE
  ENGINEERING
  CLASSIC
}

enum AcademicTitle {
  ASSISTANT
  LECTURER
  PROFESSOR
  DOCTOR
  RESEARCHER
  NONE
}

enum PostType {
  FEED
  FORUM
  QUESTION
  RESOURCE
  ANNOUNCEMENT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
}

model University {
  id              String           @id @default(uuid())
  name            String
  short_name      String           @db.VarChar(50)
  city            String
  address         String?
  email           String?
  website         String?
  phone           String?
  fculties        Faculty[]
  updated_at      DateTime         @updatedAt
  created_at      DateTime         @default(now())
  studentProfiles StudentProfile[]
  teacherProfiles TeacherProfile[]
  adminProfiles   AdminProfile[]
  departments     Department[]
}

model Faculty {
  id            Int              @id @default(autoincrement())
  name          String
  code          String           @db.VarChar(50)
  university_id String
  university    University       @relation(fields: [university_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  departments   Department[]
  students      StudentProfile[]
  updated_at    DateTime         @updatedAt
  created_at    DateTime         @default(now())
}

model Department {
  id            Int              @id @default(autoincrement())
  name          String
  code          String
  faculty_id    Int
  faculty       Faculty          @relation(fields: [faculty_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  university_id String
  university    University       @relation(fields: [university_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fields        Field[]
  leader        TeacherProfile?
  students      StudentProfile[]
  updated_at    DateTime         @updatedAt
  created_at    DateTime         @default(now())
}

model Field {
  id              Int              @id @default(autoincrement())
  name            String
  code            String
  academic_system AcademicSystem
  levels          Level[]
  department_id   Int
  department      Department       @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at      DateTime         @updatedAt
  created_at      DateTime         @default(now())
  studentProfiles StudentProfile[]
}

model Level {
  id         Int              @id @default(autoincrement())
  name       String
  cycle      DegreeCycle
  is_final   Boolean
  field_id   Int
  field      Field            @relation(fields: [field_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at DateTime         @updatedAt
  created_at DateTime         @default(now())
  modules    Module[]
  students   StudentProfile[]

  @@unique([field_id, name])
}

model Module {
  id         Int      @id @default(autoincrement())
  name       String
  code       String
  level_id   Int
  level      Level    @relation(fields: [level_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  courses    Course[]
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@index([level_id])
}

model Course {
  id                String             @id @default(uuid())
  name              String
  code              String
  description       String
  courseSections    CourseSection[]
  module_id         Int
  module            Module             @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  publisher_id      Int
  publisher         TeacherProfile     @relation(fields: [publisher_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  enrolled_students StudentProfile[]
  updated_at        DateTime           @updatedAt
  created_at        DateTime           @default(now())
  courseEnrollments CourseEnrollment[]
}

model CourseSection {
  id                Int                @id @default(autoincrement())
  order             Int
  title             String             @db.VarChar(120)
  content           String?            @db.LongText
  course_id         String
  course            Course             @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  materials         CourseMaterial[]
  updated_at        DateTime           @updatedAt
  created_at        DateTime           @default(now())
  courseEnrollments CourseEnrollment[]
}

model CourseMaterial {
  id                Int           @id @default(autoincrement())
  name              String
  type              FileTypes
  link              String
  course_section_id Int
  course_section    CourseSection @relation(fields: [course_section_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at        DateTime      @default(now())
}

model CourseEnrollment {
  id                        Int            @id @default(autoincrement())
  student_id                Int
  student                   StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  course_id                 String
  course                    Course         @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  current_course_section_id Int?
  current_course_section    CourseSection? @relation(fields: [current_course_section_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updated_at                DateTime       @updatedAt
  created_at                DateTime       @default(now())

  @@unique([student_id, course_id])
}

model Session {
  id         Int       @id @default(autoincrement())
  user_id    String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  device     String
  token      String    @unique
  is_expired Boolean   @default(false)
  expires_at DateTime?
  created_at DateTime  @default(now())
}

model Otp {
  id         Int      @id @default(autoincrement())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  code       String
  created_at DateTime @default(now())

  @@unique([user_id, code])
}

model User {
  id                    String            @id @default(uuid())
  first_name            String            @db.VarChar(35)
  last_name             String            @db.VarChar(35)
  bio                   String?           @db.VarChar(255)
  avatar_url            String?
  email                 String            @unique
  password              String
  student_id            String?           @unique
  role                  UserRoles         @default(STUDENT)
  status                UserStatus        @default(PENDING)
  onboarding_completed  Boolean           @default(false)
  sessions              Session[]
  otps                  Otp[]
  id_card_url           String?
  student_profile       StudentProfile?
  teacher_profile       TeacherProfile?
  admin_profile         AdminProfile?
  deleted_at            DateTime?
  updated_at            DateTime          @updatedAt
  created_at            DateTime          @default(now())
  posts                 Post[]
  comments              Comment[]
  likes                 Like[]
  bookmarks             Bookmark[]
  connections_received  Connection[]      @relation("receivedConnections")
  connections_sent      Connection[]      @relation("sentConnections")
  created_notifications Notification[]    @relation("notification_actor")
  notifications         Notification[]    @relation("notification_receiver")
  messages              Message[]
  chatParticipants      ChatParticipant[]
}

model StudentProfile {
  id               Int        @id @default(autoincrement())
  field_id         Int
  field            Field      @relation(fields: [field_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  univeristy_id    String
  university       University @relation(fields: [univeristy_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  enrolled_courses Course[]
  user_id          String     @unique
  user             User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  department_id    Int
  department       Department @relation(fields: [department_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  level_id          Int
  level             Level              @relation(fields: [level_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  faculty_id        Int
  faculty           Faculty            @relation(fields: [faculty_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  courseEnrollments CourseEnrollment[]
}

model TeacherProfile {
  id                  Int           @id @default(autoincrement())
  phone_number        String?       @db.VarChar(20)
  university_of_study String
  field_of_study      String
  specialization      String
  academic_title      AcademicTitle

  leading_department_id Int?        @unique
  leading_department    Department? @relation(fields: [leading_department_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  univeristy_id String
  university    University @relation(fields: [univeristy_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // students
  user_id           String   @unique
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  published_courses Course[]
  updated_at        DateTime @updatedAt
  created_at        DateTime @default(now())
}

model AdminProfile {
  id                Int         @id @default(autoincrement())
  univeristy_id     String?
  university        University? @relation(fields: [univeristy_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  admin_type        AdminType
  last_login_at     DateTime?
  login_fails_count Int         @default(0)

  permissions Permission[]
  user_id     String       @unique
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at  DateTime     @updatedAt
  created_at  DateTime     @default(now())
}

model Permission {
  id         Int          @id @default(autoincrement())
  model_name String
  admin_id   Int
  admin      AdminProfile @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  can_write  Boolean
  can_read   Boolean
  can_delete Boolean
  updated_at DateTime     @updatedAt
  created_at DateTime     @default(now())

  @@unique([admin_id, model_name])
}

model Post {
  id         Int         @id @default(autoincrement())
  content    String
  author_id  String
  type       PostType    @default(FEED)
  comments   Comment[]
  likes      Like[]
  booksmarks Bookmark[]
  author     User        @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at DateTime    @updatedAt
  created_at DateTime    @default(now())
  postMedias PostMedia[]
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  author_id  String
  post_id    Int
  author     User     @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
}

model Like {
  id         Int      @id @default(autoincrement())
  user_id    String
  post_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@unique([user_id, post_id])
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  user_id    String
  post_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@unique([user_id, post_id])
}

model PostMedia {
  id         Int       @id @default(autoincrement())
  post_id    Int
  type       FileTypes
  url        String
  post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at DateTime  @updatedAt
  created_at DateTime  @default(now())
}

model Connection {
  id          Int              @id @default(autoincrement())
  sender_id   String
  receiver_id String
  status      ConnectionStatus @default(PENDING) // PENDING, ACCEPTED, REJECTED
  sender      User             @relation("sentConnections", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiver    User             @relation("receivedConnections", fields: [receiver_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updated_at  DateTime         @updatedAt
  created_at  DateTime         @default(now())

  @@unique([sender_id, receiver_id])
}

model Notification {
  id          Int              @id @default(autoincrement())
  title       String
  body        String
  type        NotificationType
  is_read     Boolean          @default(false)
  entity_id   Int
  receiver_id String
  receiver    User             @relation(name: "notification_receiver", fields: [receiver_id], references: [id], onDelete: Cascade)
  actor_id    String
  actor       User             @relation(name: "notification_actor", fields: [actor_id], references: [id], onDelete: Cascade)
  created_at  DateTime         @default(now())
}

model Chat {
  id              Int               @id @default(autoincrement())
  messages        Message[]
  participants    ChatParticipant[]
  last_message_id Int?              @unique
  last_message    Message?          @relation(name: "last_message", fields: [last_message_id], references: [id], onDelete: Cascade)
  updated_at      DateTime           @updatedAt
  created_at      DateTime          @default(now())
}

model ChatParticipant {
  id           Int       @id @default(autoincrement())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  chat_id      Int
  last_read_at DateTime?
  chat         Chat      @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@unique([user_id, chat_id])
}

model Message {
  id            Int                 @id @default(autoincrement())
  sender_id     String?
  sender        User?               @relation(fields: [sender_id], references: [id], onDelete: SetNull)
  chat_id       Int
  chat          Chat                @relation(fields: [chat_id], references: [id], onDelete: Cascade)
  text          String?             @db.VarChar(200)
  last_for_chat Chat?               @relation(name: "last_message")
  created_at    DateTime            @default(now())

  @@index([chat_id])
  @@index([created_at])
}